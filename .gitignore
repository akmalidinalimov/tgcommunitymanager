# ---- Secrets: never commit ----
.env
.env.*
!.env.example
# .mcp.json carries HOSTINGER_API_TOKEN — comments must be on their own line,
# gitignore has no inline comment syntax and would treat it as part of the pattern.
.mcp.json
!.mcp.json.example
*.pem
*.key
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Generated media & runtime data ----
media/
storage/
*.db
*.sqlite3
logs/
*.log

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ---- Local scratch ----
scratch/
tmp/

# ---- Tooling artifacts ----
.gstack/

# Raw Telegram updates contain member names and user ids
data/corpus/*raw*
